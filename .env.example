# Copy this file to .env and fill in your values
# Never commit .env to git

# Required: Gemini API key for AI classification & summarization
# Get one free at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Required for GitHub publishing (Phase 5)
# Create a PAT at: https://github.com/settings/tokens
# Scopes needed: repo (full control of private repos)
GITHUB_TOKEN=your_github_pat_here

# Your GitHub username
GITHUB_USERNAME=your_github_username

# The private repo name to push the curated list to (will be created if missing)
GITHUB_REPO_NAME=awesome-android-root-kernel
